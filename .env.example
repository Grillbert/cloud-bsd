# Copy to .env and fill in. .env is git-ignored.

# Fast classifier (System 1)
TYPESAFE_API_KEY=

# LLM for confirmation & explanation (System 2)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# Speech recognition backend: parakeet | nemotron
ASR_BACKEND=nemotron
ASR_LANGUAGE=de-DE

# LiveKit (phase 3+)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
